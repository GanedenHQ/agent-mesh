{
  "name": "@agent-mesh/mcp",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "bin": {
    "agent-mesh-channel": "src/index.ts"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --compile --outfile dist/agent-mesh-channel && (command -v codesign >/dev/null && codesign --force --sign - dist/agent-mesh-channel || true)",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "lint:test": "tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
